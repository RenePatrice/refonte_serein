# ==============================================================================
# SEREIN-GE : Secrets requis pour les Edge Functions Supabase
# À définir avec `supabase secrets set --env-file supabase/functions/.env`
# (ne jamais committer le fichier .env réel, seulement ce .env.example)
# ==============================================================================

# Fournis automatiquement par Supabase à l'exécution, à ne définir qu'en local
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CinetPay (cinetpay-init, cinetpay-webhook)
CINETPAY_API_KEY=your-cinetpay-api-key
CINETPAY_SITE_ID=your-cinetpay-site-id

# Stripe (stripe-init, stripe-webhook) — conservé pour réactivation future,
# non utilisé par le parcours de commande actuel (WhatsApp + email uniquement)
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# SMTP (send-notification-email) — confirmations de commande & de candidature
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=no-reply@serein-ge.bf
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=SEREIN-GE <no-reply@serein-ge.bf>
# Boîte interne qui reçoit une copie de chaque commande/candidature
NOTIFICATION_EMAIL=commercial@serein-ge.bf
# URL publique du logo, insérée dans l'en-tête des emails HTML (optionnel)
COMPANY_LOGO_URL=https://serein-ge.bf/logo.png
